<Window x:Class="HuiYi.App.TemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="#1E2235" FontFamily="Microsoft YaHei UI, Segoe UI"
        Title="模板中心" Width="1000" Height="700" MinWidth="820" MinHeight="520"
        Background="#F5F6FA" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Templates -->
        <Border Background="White" BorderBrush="#E3E6EE" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,8,14">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,8,10">
                    <TextBlock Text="纪要模板" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Helper}" Text="选一个模板，AI 就按它的结构写纪要。"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="＋ 新建空白模板" Style="{StaticResource Btn}" Margin="2,10,8,0" Click="New_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListHost"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- One template -->
        <DockPanel Grid.Column="1" Margin="28,20,24,16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                    <Button x:Name="DeleteBtn" Content="删除" Style="{StaticResource DeleteBtn}" Margin="0,0,8,0" Click="Delete_Click"/>
                    <Button x:Name="CopyBtn" Content="复制为我的模板" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Copy_Click"/>
                    <Button x:Name="DefaultBtn" Content="设为默认" Style="{StaticResource PrimaryBtn}" Click="Default_Click"/>
                    <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource PrimaryBtn}" MinWidth="72" Margin="8,0,0,0" Click="Save_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource TitleField}" Tag="给模板起个名字" Visibility="Collapsed"
                             Margin="-6,0,24,0" MaxWidth="460" HorizontalAlignment="Left" MinWidth="240" ToolTip="点击修改名称"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border x:Name="CategoryChip" Background="#ECEEFC" CornerRadius="9" Padding="8,1" Margin="0,0,8,0">
                            <TextBlock x:Name="CategoryText" FontSize="11" Foreground="#4F5BD5" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="SavedText" FontSize="12" Foreground="#22B07D" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailHost" Margin="0,0,8,0"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
