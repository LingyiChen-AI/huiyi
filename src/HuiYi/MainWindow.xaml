<Window x:Class="HuiYi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="#1E2235" FontFamily="Microsoft YaHei UI, Segoe UI"
        Title="会议记录" Width="1080" Height="720" MinWidth="780" MinHeight="480"
        Background="#F5F6FA" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E3E6EE" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,8,12">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,6,10">
                    <DockPanel>
                        <Image x:Name="Logo" Width="26" Height="26" Margin="0,0,10,0"/>
                        <TextBlock x:Name="AppName" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Button x:Name="ListenBtn" Content="开始收听" Style="{StaticResource PrimaryBtn}" Margin="0,14,0,0" Padding="0,8" Click="Listen_Click"/>
                    <Grid Margin="0,12,0,0">
                        <TextBox x:Name="SearchBox" Padding="26,6,6,6" TextChanged="Search_Changed"/>
                        <TextBlock Text="⌕" Foreground="#9AA1B2" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="搜索标题或内容" Foreground="#9AA1B2" FontSize="12" Margin="27,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
                <ListBox x:Name="SessionList" BorderThickness="0" Background="Transparent" SelectionChanged="Session_Selected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#9AA1B2" Margin="6,12,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="10,8" Margin="0,1,6,1" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#F5F6FA"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#ECEEFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="#9AA1B2" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- One meeting -->
        <Grid Grid.Column="1">
            <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <TextBlock Text="还没有会议记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Style="{StaticResource Helper}" TextAlignment="Center" Margin="0,6,0,0"
                           Text="点左上角「开始收听」，或单击任务栏通知区域的图标。会议里听到的内容会整理在这里。"/>
            </StackPanel>
            <DockPanel x:Name="Detail" Visibility="Collapsed" Margin="28,20,28,16">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="NotesBtn" Content="生成纪要" Style="{StaticResource PrimaryBtn}" Click="Generate_Click" Margin="0,0,8,0"/>
                            <Button Content="导出 Markdown" Style="{StaticResource Btn}" Click="Export_Click" Margin="0,0,8,0"/>
                            <Button Content="删除" Style="{StaticResource GhostBtn}" Foreground="#9AA1B2" Click="Delete_Click"/>
                        </StackPanel>
                        <TextBox x:Name="TitleBox" FontSize="21" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0"
                                 Foreground="#1E2235" LostFocus="Title_LostFocus" KeyDown="Title_KeyDown" ToolTip="点击修改标题"/>
                    </DockPanel>
                    <TextBlock x:Name="MetaText" Foreground="#9AA1B2" FontSize="12" Margin="0,4,0,12"/>
                    <WrapPanel x:Name="SpeakersPanel" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="NotesState" DockPanel.Dock="Right" Foreground="#9AA1B2" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="#E8EBF2" CornerRadius="5" Padding="2" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabNotes" Content="纪要" GroupName="d" Style="{StaticResource Seg}" IsChecked="True" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabLines" Content="逐字稿" GroupName="d" Style="{StaticResource Seg}" Checked="Tab_Checked"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </StackPanel>
                <Grid>
                    <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto">
                        <ContentControl x:Name="NotesHost" Margin="0,0,6,0"/>
                    </ScrollViewer>
                    <Border x:Name="LinesScroll" Style="{StaticResource Panel}" Padding="0" Margin="0" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                            <ItemsControl x:Name="LinesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Who}" Foreground="{Binding WhoBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Time}" Foreground="#9AA1B2" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Src}" FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Dst}" Visibility="{Binding DstVisibility}" Foreground="#646B80" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
