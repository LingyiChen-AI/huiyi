<Window x:Class="HuiYi.App.SubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="悬浮字幕" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="900" FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- Translation first and large, the original under it; a coloured edge says who is speaking. -->
    <Border x:Name="Bar" Background="#EB111320" CornerRadius="16" Cursor="SizeAll" BorderBrush="#4F5BD5" BorderThickness="5,0,0,0">
        <Grid>
            <Grid Margin="18,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border x:Name="Shared" Background="#3A3F55" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" Visibility="Collapsed">
                            <TextBlock Text="共享中可见" Foreground="#E8EAF2" FontSize="11"/>
                        </Border>
                        <Button x:Name="CloseBtn" Content="结束" FontSize="11" Padding="8,1" Foreground="#8E94A8" Background="Transparent"
                                BorderBrush="#3A3F55" Cursor="Hand" ToolTip="结束这场会议的收听" Click="Stop_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#22B07D" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="WhoText" Text="收听中" Foreground="#8E94A8" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="TranslationText" Grid.Row="1" Foreground="White" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="SourceText" Grid.Row="2" Foreground="#A7ADC0" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
