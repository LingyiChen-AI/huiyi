<Project Sdk="Microsoft.NET.Sdk">

  <!-- The installer people download: pick a folder, then it runs Velopack's Setup.exe (embedded) with
       installto. Built on .NET Framework 4.8, which every supported Windows already has, so it adds
       next to nothing to the package. Build with -p:VelopackSetup=<path to HuiYi.App-win-Setup.exe>. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HuiYi-Setup</AssemblyName>
    <RootNamespace>HuiYi.Setup</RootNamespace>
    <ApplicationIcon>..\assets\HuiYi.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>会译</Product>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\HuiYi.Core\Localization\L.cs" Link="Localization\L.cs" />
    <EmbeddedResource Include="..\src\HuiYi.Core\Localization\Strings*.resx" Link="Localization\%(Filename)%(Extension)">
      <WithCulture>false</WithCulture>
      <LogicalName>HuiYi.Localization.%(Filename).resources</LogicalName>
    </EmbeddedResource>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="$(VelopackSetup)" LogicalName="VelopackSetup.exe" Condition="'$(VelopackSetup)' != ''" />
  </ItemGroup>

</Project>
