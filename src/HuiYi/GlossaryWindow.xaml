<Window x:Class="HuiYi.App.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HuiYi.App"
        Foreground="#1E2235" FontFamily="Microsoft YaHei UI, Segoe UI"
        Title="{local:Loc Key='词库'}" Width="960" Height="680" MinWidth="780" MinHeight="520"
        Background="#F5F6FA" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The terms -->
        <Border Background="White" BorderBrush="#E3E6EE" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,8,14">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,8,10">
                    <TextBlock Text="{local:Loc Key='词库'}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Helper}" TextWrapping="Wrap"
                               Text="{local:Loc Key='人名、产品名、行业术语：识别、翻译和纪要都按这里的写法来。'}"/>
                    <TextBox x:Name="SearchBox" Tag="{local:Loc Key='搜索词条'}" Margin="0,10,0,0" TextChanged="Search_Changed"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="2,10,8,0">
                    <Button Content="{local:Loc Key='＋ 添加词条'}" Style="{StaticResource PrimaryBtn}" Click="New_Click"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="{local:Loc Key='导入'}" Style="{StaticResource Btn}" Click="Import_Click"/>
                        <Button Grid.Column="2" Content="{local:Loc Key='导出'}" Style="{StaticResource Btn}" Click="Export_Click"/>
                    </Grid>
                    <TextBlock x:Name="CountText" Style="{StaticResource Helper}" Margin="2,8,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListHost"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- One term -->
        <DockPanel Grid.Column="1" Margin="28,20,24,16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                    <Button x:Name="DeleteBtn" Content="{local:Loc Key='删除'}" Style="{StaticResource DeleteBtn}" Margin="0,0,8,0" Click="Delete_Click"/>
                    <Button x:Name="SaveBtn" Content="{local:Loc Key='保存'}" Style="{StaticResource PrimaryBtn}" MinWidth="72" Click="Save_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SavedText" FontSize="12" Foreground="#22B07D" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="{local:Loc Key='正确写法'}" FontWeight="SemiBold"/>
                            <TextBox x:Name="TextBox" Tag="{local:Loc Key='比如：伊丽静、Kubernetes、网关'}" Margin="0,6,0,0" TextChanged="Field_Changed"/>

                            <TextBlock Text="{local:Loc Key='常被听成'}" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <TextBox x:Name="MisheardBox" Tag="{local:Loc Key='比如：毕丽静、伊利静'}" Margin="0,6,0,0" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Helper}" TextWrapping="Wrap"
                                       Text="{local:Loc Key='识别成这些写法时，一律改成正确写法。多个用逗号分隔。'}"/>

                            <TextBlock Text="{local:Loc Key='译法'}" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <TextBox x:Name="TranslationBox" Tag="{local:Loc Key='比如：gateway; ja=ゲートウェイ'}" Margin="0,6,0,0" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Helper}" TextWrapping="Wrap"
                                       Text="{local:Loc Key='翻译时固定这样译。直接写的是英文译法，其他语言写成「ja=…」，用分号隔开。'}"/>

                            <TextBlock Text="{local:Loc Key='说明'}" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <TextBox x:Name="NoteBox" Tag="{local:Loc Key='比如：支付请求的入口服务（写纪要时 AI 会参考）'}" Margin="0,6,0,0" TextChanged="Field_Changed"/>

                            <TextBlock Text="{local:Loc Key='分组'}" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <ComboBox x:Name="GroupBox" IsEditable="True" Margin="0,6,0,0" MinHeight="32"
                                      TextBoxBase.TextChanged="Field_Changed" SelectionChanged="Group_Selected"/>
                            <TextBlock Style="{StaticResource Helper}" TextWrapping="Wrap"
                                       Text="{local:Loc Key='留空就是通用词条，所有会议都用。填一个分组名（如「支付项目」），可以在左侧分组标题上设置只在哪些模板的会议里用。'}"/>

                            <CheckBox x:Name="EnabledBox" Style="{StaticResource SwitchRow}" Content="{local:Loc Key='启用这个词条'}" Margin="0,18,0,0"
                                      Checked="Field_Changed" Unchecked="Field_Changed"/>
                            <CheckBox x:Name="ExactBox" Style="{StaticResource SwitchRow}" Content="{local:Loc Key='只替换列出的写法，不按读音猜'}" Margin="0,10,0,0"
                                      Checked="Field_Changed" Unchecked="Field_Changed"/>
                            <TextBlock Style="{StaticResource Helper}" TextWrapping="Wrap"
                                       Text="{local:Loc Key='默认还会按读音纠正：两个字的词要读音完全相同，三个字以上可以有 zh/z、n/l、前后鼻音这类口音差别。'}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="{local:Loc Key='试一试'}" Style="{StaticResource Overline}"/>
                            <TextBox x:Name="TryBox" Tag="{local:Loc Key='输入一句识别出来的话，看看会被改成什么'}" TextChanged="Try_Changed"/>
                            <TextBlock x:Name="TryResult" FontSize="14" TextWrapping="Wrap" Margin="2,10,0,0"/>
                            <TextBlock x:Name="TryFixes" Style="{StaticResource Helper}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
