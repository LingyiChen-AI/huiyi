<Window x:Class="HuiYi.App.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="#E8EAF2" FontFamily="Microsoft YaHei UI, Segoe UI"
        Title="实时面板" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip"
        Width="400" Height="640" MinWidth="320" MinHeight="320">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource NightScrollBar}"/>
        <!-- The resize grip in the corner: three faint dots instead of the light system pattern. -->
        <Style TargetType="ResizeGrip">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ResizeGrip">
                        <Grid Width="14" Height="14" Background="Transparent" Margin="0,0,3,3">
                            <Ellipse Width="2.5" Height="2.5" Fill="#5F6578" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <Ellipse Width="2.5" Height="2.5" Fill="#5F6578" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,0"/>
                            <Ellipse Width="2.5" Height="2.5" Fill="#5F6578" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#1B1E2B" CornerRadius="10" BorderBrush="#2E3346" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: drag to move -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent" Margin="16,12,10,10" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="OnAirPill" Background="#2C3148" CornerRadius="9" Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#FF5C6C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StateText" Text="收听中" Foreground="#E8EAF2" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ClockText" Text="00:00" Foreground="#8E94A8" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border x:Name="Shared" Background="#3A3F55" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" Visibility="Collapsed"
                            ToolTip="截图、录屏和屏幕共享里看不到这个窗口（设置 › 字幕里可以改）" VerticalAlignment="Center">
                        <TextBlock Text="对方看不到" Foreground="#E8EAF2" FontSize="11"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StartBtn" Content="开始新会议" Style="{StaticResource PrimaryBtn}" Padding="10,3" Visibility="Collapsed" Click="Start_Click"/>
                    <Button x:Name="StopBtn" Content="结束会议" Style="{StaticResource NightBtn}" Click="Stop_Click"/>
                    <Button Content="收起" Style="{StaticResource NightBtn}" Background="Transparent" BorderBrush="Transparent"
                            Foreground="#8E94A8" ToolTip="收起面板，继续在后台收听" Click="Hide_Click" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- The meeting looks over -->
            <Border x:Name="EndBanner" Grid.Row="1" Background="#3A2F22" CornerRadius="6" Margin="12,0,12,10" Padding="12,9" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="EndText" TextWrapping="Wrap" FontSize="13" Foreground="#F3C995"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="不结束，继续" Style="{StaticResource NightBtn}" Click="KeepGoing_Click"/>
                        <Button Content="现在结束" Style="{StaticResource NightBtn}" Background="Transparent" BorderBrush="Transparent"
                                Foreground="#F3C995" Margin="6,0,0,0" Click="Stop_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Segmented switch -->
            <DockPanel Grid.Row="2" Margin="14,0,14,8">
                <CheckBox x:Name="TranslateSwitch" DockPanel.Dock="Right" Content="翻译" FontSize="12" Style="{StaticResource SwitchNight}"
                          VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="把对方说的话译成你的语言" Click="Translate_Click"/>
                <TextBlock x:Name="NotesState" DockPanel.Dock="Right" Foreground="#8E94A8" FontSize="12" VerticalAlignment="Center"/>
                <Border Background="#252939" CornerRadius="5" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabLines" Content="逐字稿" GroupName="tab" Style="{StaticResource SegNight}" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabNotes" Content="纪要" GroupName="tab" Style="{StaticResource SegNight}" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <Grid Grid.Row="3" Margin="4,0,4,6">
                <ScrollViewer x:Name="LinesScroll" VerticalScrollBarVisibility="Auto" Padding="12,4,12,4">
                    <StackPanel>
                        <ItemsControl x:Name="LinesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Fill="{Binding WhoBrush}" RadiusX="1.5" RadiusY="1.5"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Click the speaker to name them (for the whole meeting). -->
                                                <Border x:Name="whoChip" CornerRadius="4" Padding="4,0,4,1" Margin="-4,0,0,0" Background="Transparent"
                                                        Cursor="Hand" ToolTip="点击给这位发言人改名" MouseLeftButtonUp="Who_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Who}" Foreground="{Binding WhoBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="pen" Text="✎" Foreground="{Binding WhoBrush}" FontSize="10" Margin="4,0,0,0" Opacity="0"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding Time}" Foreground="#5F6578" FontSize="11" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Dst}" Visibility="{Binding DstVisibility}" FontSize="15" Foreground="#F2F3F8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Src}" Foreground="#8E94A8" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Renamable}" Value="False">
                                            <Setter TargetName="whoChip" Property="Cursor" Value="Arrow"/>
                                            <Setter TargetName="whoChip" Property="ToolTip" Value="{x:Null}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Renamable}" Value="True"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=whoChip}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="whoChip" Property="Background" Value="#2C3148"/>
                                            <Setter TargetName="pen" Property="Opacity" Value="0.9"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="LivePanel" Visibility="Collapsed" BorderBrush="#3A3F55" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="LiveWho" Foreground="#8E94A8" FontSize="11"/>
                                <TextBlock x:Name="LiveDst" Foreground="#E8EAF2" FontSize="15" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock x:Name="LiveSrc" Foreground="#6E7488" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="EmptyHint" FontSize="13" Foreground="#6E7488" TextWrapping="Wrap" Margin="2,16,2,0"
                                   Text="电脑里有人说话时，逐字稿会一句句出现在这里。"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto" Padding="14,4,14,4" Visibility="Collapsed">
                    <ContentControl x:Name="NotesHost"/>
                </ScrollViewer>
                <!-- Opened from the tray before a meeting: nothing records until 开始会议. -->
                <Border x:Name="ReadyPanel" Background="Transparent" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40">
                        <!-- A soft halo round the mic. -->
                        <Grid Width="84" Height="84" HorizontalAlignment="Center">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#447C8BFF" Offset="0.55"/>
                                        <GradientStop Color="#007C8BFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border Width="58" Height="58" CornerRadius="29" BorderBrush="#4A538C" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#363E72" Offset="0"/>
                                        <GradientStop Color="#272C4A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="#C9CEFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="准备好了就开始" FontSize="18" FontWeight="SemiBold" Foreground="#F4F5FA" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock FontSize="12.5" Foreground="#9AA0B4" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="270" Margin="0,8,0,22" LineHeight="20"
                                   Text="点「开始会议」后，会译开始收听电脑里的声音，实时出字幕、整理纪要。"/>
                        <Button Click="Start_Click" HorizontalAlignment="Center" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="9" Padding="30,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#7E8BFF" Offset="0"/>
                                                <GradientStop Color="#5A5FEA" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#5A5FEA" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#FF6B78" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            <TextBlock Text="开始会议" FontSize="14.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Speak-back -->
            <Border x:Name="SpeakBar" Grid.Row="4" Margin="12,0,12,12" Padding="10,7" CornerRadius="6" Background="#252939" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="SpeakDot" Width="7" Height="7" Fill="#8E94A8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SpeakText" FontSize="12" Foreground="#B8BDCD" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
