<Window x:Class="HuiYi.App.SubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HuiYi.App"
        Title="{local:Loc Key='悬浮字幕'}" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="900" FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- Translation first and large, the original under it; a coloured edge says who is speaking. -->
    <Border x:Name="Bar" Background="#EB111320" CornerRadius="16" Cursor="SizeAll" BorderBrush="#4F5BD5" BorderThickness="5,0,0,0">
        <Grid>
            <Grid Margin="18,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border x:Name="Shared" Background="#3A3F55" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock Text="{local:Loc Key='对方看不到'}" Foreground="#E8EAF2" FontSize="11"/>
                        </Border>
                        <Button x:Name="MicBtn" Style="{StaticResource NightIconBtn}" Click="Mic_Click" Margin="0,0,2,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MicIcon" Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                        <Button x:Name="PanelBtn" Style="{StaticResource NightIconBtn}" Click="Panel_Click" Margin="0,0,8,0" VerticalAlignment="Center"
                                ToolTip="{local:Loc Key='切换成实时面板：逐字稿和纪要'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{local:Loc Key='面板'}" FontSize="11" Margin="5,0,0,1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseBtn" Content="{local:Loc Key='结束'}" FontSize="11" Padding="8,1" Foreground="#8E94A8" Background="Transparent"
                                BorderBrush="#3A3F55" Cursor="Hand" ToolTip="{local:Loc Key='结束这场会议的收听'}" Click="Stop_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#22B07D" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="WhoText" Text="{local:Loc Key='收听中'}" Foreground="#8E94A8" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
                <!-- Each stream keeps a fixed two lines and shows its end: new words push old lines out at
                     the top, and the window never changes height while someone talks. -->
                <Border x:Name="TranslationBox" Grid.Row="1" ClipToBounds="True">
                    <TextBlock x:Name="TranslationText" Foreground="White" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                               VerticalAlignment="Bottom" LineStackingStrategy="BlockLineHeight"/>
                </Border>
                <Border x:Name="SourceBox" Grid.Row="2" ClipToBounds="True" Margin="0,4,0,0">
                    <TextBlock x:Name="SourceText" Foreground="#A7ADC0" FontSize="15" TextWrapping="Wrap"
                               VerticalAlignment="Bottom" LineStackingStrategy="BlockLineHeight"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
