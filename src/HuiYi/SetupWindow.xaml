<Window x:Class="HuiYi.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="#1E2235" FontFamily="Microsoft YaHei UI, Segoe UI"
        Title="开始使用" Width="720" Height="500" Background="White" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: brand and the steps -->
        <Border Background="#1B1E2B">
            <DockPanel Margin="24,28,20,24">
                <StackPanel DockPanel.Dock="Top">
                    <Image x:Name="Logo" Width="40" Height="40" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,14,0,0"/>
                    <TextBlock Text="听懂每一场跨语言会议" Foreground="#8E94A8" FontSize="12" Margin="0,4,0,28"/>
                </StackPanel>
                <StackPanel x:Name="Steps"/>
            </DockPanel>
        </Border>

        <!-- Right: one step at a time -->
        <DockPanel Grid.Column="1" Margin="36,32,32,24">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button x:Name="NextBtn" DockPanel.Dock="Right" Content="下一步" Style="{StaticResource PrimaryBtn}" Padding="22,7" Click="Next_Click"/>
                <Button x:Name="BackBtn" DockPanel.Dock="Right" Content="上一步" Style="{StaticResource GhostBtn}" Margin="0,0,8,0" Click="Back_Click"/>
                <TextBlock x:Name="DoneHint" Style="{StaticResource Helper}" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid>
                <!-- 1 -->
                <StackPanel x:Name="Page0">
                    <TextBlock Text="第 1 步 · 准备识别模型" Style="{StaticResource Overline}"/>
                    <TextBlock Text="下载本机语音模型" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Helper}" FontSize="13" Margin="0,8,0,0"
                               Text="约 260 MB，只需下载一次。语音识别和发言人区分都在这台电脑上完成，会议声音不会上传。"/>
                    <ProgressBar x:Name="ModelProgress" Height="8" Margin="0,28,0,0" Foreground="#4F5BD5" Background="#ECEEFC" BorderThickness="0" Maximum="1"/>
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="ModelBtn" DockPanel.Dock="Right" Content="重新下载" Style="{StaticResource Btn}" Click="Model_Click"/>
                        <TextBlock x:Name="ModelText" VerticalAlignment="Center" FontSize="13" Foreground="#646B80"/>
                    </DockPanel>
                </StackPanel>
                <!-- 2 -->
                <StackPanel x:Name="Page1" Visibility="Collapsed">
                    <TextBlock Text="第 2 步 · 试听" Style="{StaticResource Overline}"/>
                    <TextBlock Text="放一段外语视频试试" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Helper}" FontSize="13" Margin="0,8,0,0"
                               Text="点「开始收听」，然后在电脑上播放任意外语视频或会议录音，译文会实时出现在下面。"/>
                    <Border Background="#111320" CornerRadius="12" Padding="18,14" Margin="0,20,0,0" MinHeight="96">
                        <StackPanel>
                            <TextBlock x:Name="TryDst" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="等待声音…"/>
                            <TextBlock x:Name="TrySrc" Foreground="#A7ADC0" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="TryBtn" Content="开始收听" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Try_Click"/>
                </StackPanel>
                <!-- 3 -->
                <StackPanel x:Name="Page2" Visibility="Collapsed">
                    <TextBlock Text="第 3 步 · AI 纪要（可跳过）" Style="{StaticResource Overline}"/>
                    <TextBlock Text="填入 Ling API key" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Helper}" FontSize="13" Margin="0,8,0,0"
                               Text="有 key 时，开会过程中会自动整理纪要、识别发言人姓名，人名术语也翻得更准。没有也能正常看字幕。"/>
                    <DockPanel Margin="0,24,0,0">
                        <Button x:Name="KeyBtn" DockPanel.Dock="Right" Content="保存并验证" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" Click="Key_Click"/>
                        <PasswordBox x:Name="KeyBox"/>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="去申请 key ↗" Style="{StaticResource GhostBtn}" Click="GetKey_Click"/>
                        <TextBlock x:Name="KeyText" FontSize="13" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <!-- 4 -->
                <StackPanel x:Name="Page3" Visibility="Collapsed">
                    <TextBlock Text="第 4 步 · 同传发言（可跳过）" Style="{StaticResource Overline}"/>
                    <TextBlock Text="让对方听懂你说的话" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Helper}" FontSize="13" Margin="0,8,0,0"
                               Text="按住右 Ctrl 说中文，松开后自动译成对方的语言，通过虚拟麦克风播报进会议。需要先安装免费的 VB-CABLE，再在会议软件里把麦克风选成「CABLE Output」。"/>
                    <Border Style="{StaticResource Panel}" Background="#F5F6FA" BorderThickness="0" Margin="0,22,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="CableBtn" DockPanel.Dock="Right" Content="下载 VB-CABLE ↗" Style="{StaticResource Btn}" Click="Cable_Click"/>
                                <TextBlock x:Name="CableText" FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>
                            <CheckBox x:Name="SpeakOn" Content="启用同传发言" Margin="0,12,0,0" Checked="Speak_Changed" Unchecked="Speak_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
