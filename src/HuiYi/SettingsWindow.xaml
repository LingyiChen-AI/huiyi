<Window x:Class="HuiYi.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="#1E2235" FontFamily="Microsoft YaHei UI, Segoe UI"
        Title="设置" Width="640" Height="620" MinWidth="560" MinHeight="460" Background="#F5F6FA" WindowStartupLocation="CenterScreen">
    <TabControl x:Name="Pages" Background="Transparent" BorderThickness="0" Padding="0" Margin="24,12,24,16">
        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource PageTab}"/>
        </TabControl.Resources>

        <!-- 字幕 -->
        <TabItem Header="字幕">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="翻译" Style="{StaticResource Overline}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox x:Name="TranslateOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="Changed" Unchecked="Changed"/>
                                <TextBlock Text="翻译字幕" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Helper}" Text="默认关闭，只显示原文。开会时也可以在实时面板右上角或托盘菜单里随时打开。"/>
                            <DockPanel Style="{StaticResource Row}" Margin="0,10,0,0">
                                <ComboBox x:Name="TargetBox" DockPanel.Dock="Right" SelectionChanged="Changed"/>
                                <TextBlock Text="译成" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Helper}" Text="自动：外语译成你的系统语言；对方说你的语言时，译成你的第二语言。"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="显示" Style="{StaticResource Overline}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Background="#E8EBF2" CornerRadius="5" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeNotes" Content="实时面板" GroupName="mode" Style="{StaticResource Seg}" Checked="Changed"/>
                                        <RadioButton x:Name="ModeSubs" Content="悬浮字幕" GroupName="mode" Style="{StaticResource Seg}" Checked="Changed"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="收听时打开" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <Slider x:Name="FontSlider" DockPanel.Dock="Right" Width="190" Minimum="16" Maximum="44" TickFrequency="2"
                                        IsSnapToTickEnabled="True" ValueChanged="Font_Changed"/>
                                <TextBlock x:Name="FontText" Text="悬浮字幕字号" VerticalAlignment="Center"/>
                            </DockPanel>
                            <CheckBox x:Name="Capturable" Style="{StaticResource Switch}" Content="在屏幕共享和录屏中显示字幕窗口" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed"/>
                            <TextBlock Style="{StaticResource Helper}" Text="关闭时只有你自己看得到；打开后窗口上会标「共享中可见」。"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="发言人" Style="{StaticResource Overline}"/>
                            <CheckBox x:Name="VoicesOn" Style="{StaticResource Switch}" Content="按声音区分不同发言人（发言人 1、发言人 2…）" Checked="Changed" Unchecked="Changed"/>
                            <TextBlock Style="{StaticResource Helper}" Text="同一个声音说过两句后开始编号（之前的句子会一起补上）；太短的话（如“嗯”“好的”）不计入。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- AI 服务 -->
        <TabItem Header="AI 服务">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="当前使用" Style="{StaticResource Overline}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="＋ 添加服务" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="AddProvider_Click"/>
                                <ComboBox x:Name="ActiveBox" SelectionChanged="Active_Changed"/>
                            </DockPanel>
                            <TextBlock x:Name="KeyState" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Helper}" Text="用于会议纪要、整句翻译和识别发言人姓名。可以添加多个，随时切换；不设置也能用，只是没有 AI 纪要，整句翻译改用 Google。"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="EditorCard" Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="服务设置" Style="{StaticResource Overline}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="PresetBox" DockPanel.Dock="Right" MinWidth="280" MaxDropDownHeight="420" SelectionChanged="Preset_Changed"/>
                                <TextBlock Text="平台" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="PresetHint" Style="{StaticResource Helper}" Margin="0,0,0,4"/>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBox x:Name="NameBox" DockPanel.Dock="Right" Width="280"/>
                                <TextBlock Text="名称" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBox x:Name="UrlBox" DockPanel.Dock="Right" Width="280"/>
                                <TextBlock Text="Base URL" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <PasswordBox x:Name="KeyBox" DockPanel.Dock="Right" Width="280"/>
                                <TextBlock Text="API key" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button x:Name="KeyLink" DockPanel.Dock="Right" Content="去申请 key ↗" Style="{StaticResource GhostBtn}" Click="GetKey_Click"/>
                                <TextBlock x:Name="KeyHint" Style="{StaticResource Helper}" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ComboBox x:Name="ModelBox" IsEditable="True" Width="280" MaxDropDownHeight="360"/>
                                </StackPanel>
                                <TextBlock Text="模型" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,2,0,0">
                                <Button x:Name="FetchBtn" DockPanel.Dock="Right" Content="获取模型列表" Style="{StaticResource GhostBtn}" Click="FetchModels_Click"/>
                                <TextBlock x:Name="ModelHint" Style="{StaticResource Helper}" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>
                            <DockPanel Margin="0,14,0,0">
                                <Button DockPanel.Dock="Right" x:Name="SaveBtn" Content="保存并验证" Style="{StaticResource PrimaryBtn}" Click="SaveProvider_Click"/>
                                <Button x:Name="DeleteBtn" Content="删除这个服务" Style="{StaticResource GhostBtn}" Foreground="#9AA1B2"
                                        HorizontalAlignment="Left" Click="DeleteProvider_Click"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Helper}" Text="key 加密保存在这台电脑上，不会出现在日志和导出文件里。"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="纪要" Style="{StaticResource Overline}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="TemplateDefaultBox" DockPanel.Dock="Right" MinWidth="220" MaxDropDownHeight="420" SelectionChanged="Changed"/>
                                <TextBlock Text="默认模板" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="打开模板中心" Style="{StaticResource GhostBtn}" Click="Templates_Click"/>
                                <TextBlock Style="{StaticResource Helper}" Margin="0" VerticalAlignment="Center"
                                           Text="15 个内置模板：项目周会、站会、需求评审、复盘、客户拜访、面试……也可以自己做。"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="NotesLangBox" DockPanel.Dock="Right" SelectionChanged="Changed"/>
                                <TextBlock Text="纪要用的语言" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 同声传译 -->
        <TabItem Header="同声传译">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="按键说话" Style="{StaticResource Overline}"/>
                            <CheckBox x:Name="SpeakOn" Style="{StaticResource Switch}" Content="打开同声传译：按住按键说话，松开后译成对方的语言，播报进会议" Checked="Changed" Unchecked="Changed"/>
                            <DockPanel Style="{StaticResource Row}" Margin="0,10,0,0">
                                <Border DockPanel.Dock="Right" Background="#E8EBF2" CornerRadius="5" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="KeyCtrl" Content="右 Ctrl" GroupName="key" Style="{StaticResource Seg}" Checked="Changed"/>
                                        <RadioButton x:Name="KeyAlt" Content="右 Alt" GroupName="key" Style="{StaticResource Seg}" Checked="Changed"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="按住的键" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="SpeakTargetBox" DockPanel.Dock="Right" MinWidth="220" SelectionChanged="Changed"/>
                                <TextBlock Text="译成" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <ComboBox x:Name="MicBox" DockPanel.Dock="Right" MinWidth="220" MaxWidth="300" SelectionChanged="Changed"/>
                                <TextBlock Text="我的麦克风" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="虚拟麦克风" Style="{StaticResource Overline}"/>
                            <DockPanel>
                                <Button x:Name="CableBtn" DockPanel.Dock="Right" Content="一键安装" Style="{StaticResource PrimaryBtn}" Click="Cable_Click"/>
                                <TextBlock x:Name="CableText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock x:Name="CableHelp" Style="{StaticResource Helper}" TextWrapping="Wrap"/>
                            <CheckBox x:Name="RouteOn" Style="{StaticResource Switch}" Margin="0,10,0,0" Checked="Changed" Unchecked="Changed"
                                      Content="打开同声传译时，自动把系统麦克风切到 CABLE Output"/>
                            <TextBlock Style="{StaticResource Helper}" TextWrapping="Wrap"
                                       Text="会议软件的麦克风用「默认」就行，对方只听得到翻译后的声音，听不到你的原声。关掉同声传译或退出会译时自动切回原来的麦克风。"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="播报声音" Style="{StaticResource Overline}"/>
                            <DockPanel x:Name="VoiceRow" Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Content="▶ 试听" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="TryVoice_Click"/>
                                <ComboBox x:Name="VoiceBox" DockPanel.Dock="Right" MinWidth="220" SelectionChanged="Voice_Changed"/>
                                <TextBlock Text="声音" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- No Windows voice for the language: offer to add Windows' own voice pack. -->
                            <DockPanel x:Name="VoiceMissing" Style="{StaticResource Row}" Visibility="Collapsed">
                                <Button x:Name="VoiceInstallBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Click="VoiceInstall_Click"/>
                                <TextBlock x:Name="VoiceMissingText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock x:Name="VoiceHelp" Style="{StaticResource Helper}" TextWrapping="Wrap"/>
                            <Button x:Name="VoiceSettingsBtn" Content="打开系统语音设置 ↗" Style="{StaticResource GhostBtn}" HorizontalAlignment="Left"
                                    Margin="-6,2,0,0" Visibility="Collapsed" Click="VoiceSettings_Click"/>
                            <CheckBox x:Name="MonitorOn" Style="{StaticResource Switch}" Content="播报时自己的耳机里也放一遍" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 会议 -->
        <TabItem Header="会议">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="自动结束" Style="{StaticResource Overline}"/>
                            <CheckBox x:Name="FollowApps" Style="{StaticResource Switch}" Content="会议软件挂断后，自动结束本场记录" Checked="Changed" Unchecked="Changed"/>
                            <TextBlock Style="{StaticResource Helper}" Text="识别 Zoom、Teams、腾讯会议、飞书、钉钉、Webex 等：它们不再占用麦克风，就当作会议结束。"/>
                            <DockPanel Style="{StaticResource Row}" Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ComboBox x:Name="SilenceMinBox" MinWidth="90" SelectionChanged="Changed"/>
                                    <ComboBox x:Name="SilenceBox" MinWidth="130" Margin="8,0,0,0" SelectionChanged="Changed"/>
                                </StackPanel>
                                <TextBlock Text="没人说话超过" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 通用 -->
        <TabItem Header="通用">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="启动" Style="{StaticResource Overline}"/>
                            <CheckBox x:Name="LoginOn" Style="{StaticResource Switch}" Content="登录 Windows 后自动启动" Checked="Changed" Unchecked="Changed"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="本机模型与数据" Style="{StaticResource Overline}"/>
                            <TextBlock x:Name="ModelState" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="打开数据文件夹" Style="{StaticResource Btn}" Click="OpenData_Click" Margin="0,0,8,0"/>
                                <Button Content="查看运行日志" Style="{StaticResource GhostBtn}" Click="OpenLog_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="AboutText" Style="{StaticResource Helper}" Margin="2,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
